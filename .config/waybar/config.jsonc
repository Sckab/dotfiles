{
    "layer": "top",
    "position": "bottom",
    "modules-left": [
        "hyprland/workspaces"
    ],
    "modules-right": [
        "network",
        "pulseaudio",
        "clock"
    ],
    "modules-center": [
        "hyprland/window"
    ],
    "clock": {
        "format-alt": "{:%a, %d. %b  %H:%M}"
    },
    "pulseaudio": {
        "format": "Volume: {volume}%",
        "on-click": "hyprpwcenter"
    },
    "network": {
        "interface": "enp8s0",
        "format": "",
        "format-wifi": "  ({signalStrength}%)",
        "format-ethernet": "",
        "format-disconnected": "Disconnected ⚠ "
    },
    "hyprland/window": {
        "separate-outputs": true
    }
}
