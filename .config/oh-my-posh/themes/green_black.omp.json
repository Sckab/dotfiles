{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "final_space": true,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "os",
          "style": "powerline",
          "foreground": "p:gray",
          "background": "p:green",
          "template": "{{ .Icon }} ",
          "leading_powerline_symbol": "",
          "powerline_symbol": ""
        },
        {
          "type": "session",
          "style": "powerline",
          "background": "p:green",
          "foreground": "p:gray",
          "leading_powerline_symbol": "",
          "powerline_symbol": "",
          "template": "{{ if .SSHSession }} {{ end }}{{.UserName}}@{{.HostName}}"
        },
        {
          "type": "path",
          "style": "powerline",
          "background": "p:gray",
          "foreground": "p:green",
          "powerline_symbol": "",
          "options": {
            "home_icon": " ",
            "style": "full",
            "folder_icon": " ",
            "folder_separator_icon": "  "
          }
        },
        {
          "type": "python",
          "style": "powerline",
          "background": "p:gray",
          "foreground": "p:green",
          "template": "{{ if .Venv }} (venv: {{ .Venv }}) {{ end }}"
        },
        {
          "type": "executiontime",
          "style": "powerline",
          "background": "p:gray",
          "foreground": "p:green",
          "powerline_symbol": "",
          "options": {
            "style": "roundrock",
            "always_enabled": true
          }
        }
      ]
    },
    {
      "type": "rprompt",
      "alignment": "right",
      "segments": [
        {
          "background": "p:gray",
          "foreground": "p:green",
          "invert_powerline": true,
          "style": "powerline",
          "powerline_symbol": "",
          "type": "git"
        },
        {
          "type": "project",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "p:green",
          "background": "p:gray",
          "template": "{{ if .Error }}{{ .Error }}{{ else }}{{ if .Version }} {{ .Version }} {{ end }}{{ if eq .Type `dotnet` }}󰪮 {{ else if eq .Type `node` }} {{ end }}{{ .Type }}  {{ end }}{{ if .Name }}{{ .Name }}{{ end }}"
        },
        {
          "background": "p:gray",
          "foreground": "p:green",
          "invert_powerline": true,
          "style": "powerline",
          "powerline_symbol": "",
          "type": "status",
          "template": " {{ if eq .Code 0 }} {{ else }} {{ .Code }}{{ end }} ",
          "options": {
            "always_enabled": true
          }
        },
        {
          "background": "p:green",
          "foreground": "p:gray",
          "options": {
            "time_format": "15:04"
          },
          "invert_powerline": true,
          "style": "diamond",
          "template": " {{ .CurrentDate | date .Format }}",
          "trailing_diamond": "",
          "type": "time"
        }
      ]
    }
  ],
  "palette": {
    "green": "#76946A",
    "gray": "#2a2a2a"
  }
}
